# Server-only Realtime Database credentials from a Firebase service account.
FIREBASE_PROJECT_ID=your-project-id
# Or use your existing NEXT_PUBLIC_FIREBASE_DB_URL. Copy the URL from Firebase Console.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Use a long random secret; configure the same value in your scheduler's header.
CRON_SECRET=replace-with-a-long-random-secret

# Server-only Utopia Intel account. Never use NEXT_PUBLIC_ for these values.
UTOPIA_INTEL_USERNAME=your-intel-account-email
UTOPIA_INTEL_PASSWORD=your-intel-account-password
